# ---------------------------------------------------------------------------
# PesaRef environment variables
# Copy this file to .env (local dev) and set the real values in the Netlify
# dashboard (Site settings -> Environment variables) for deployment.
# NEVER commit a filled-in .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used at runtime by Prisma Client.
# If your provider (Neon, Supabase, RDS Proxy, PgBouncer) offers a pooled
# connection string, use it here.
DATABASE_URL="postgresql://user:password@host:5432/pesaref?schema=public&sslmode=require"

# Direct (non-pooled) connection string, used only for `prisma migrate`.
# If your provider does not distinguish pooled/direct, set this to the same
# value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/pesaref?schema=public&sslmode=require"

# Secret used to sign session JWTs and password-reset tokens.
# Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Public base URL of the deployed app (no trailing slash).
# Used to build referral links and email/SMS links.
APP_URL="http://localhost:3000"

# Credentials used ONLY by `npm run prisma:seed` to create the initial
# SUPER_ADMIN account. Not read at runtime by the app itself.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisImmediately123!"
ADMIN_FULL_NAME="Platform Administrator"
ADMIN_PHONE="+254700000000"

# --- Notification providers (all optional; features degrade gracefully) ----
# Set to "console" (default, logs only) or a supported provider key.
EMAIL_PROVIDER="console"
SMS_PROVIDER="console"

# Resend (email) - used only if EMAIL_PROVIDER=resend
RESEND_API_KEY=""
EMAIL_FROM="PesaRef <no-reply@example.com>"

# Africa's Talking (SMS) - used only if SMS_PROVIDER=africastalking
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""
AFRICASTALKING_SENDER_ID=""

# --- Business configuration defaults (also editable by SUPER_ADMIN in-app) -
REGISTRATION_FEE_KES="500"
REFERRAL_COMMISSION_KES="250"
MIN_WITHDRAWAL_KES="250"
