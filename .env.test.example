# Copy to .env.test for running `npm test` locally.
#
# IMPORTANT: point this at a disposable database that is NOT your
# development database. tests/integration/helpers.ts truncates users,
# payments, referrals, wallets, withdrawals, and settings before every test -
# running the suite against your dev/seed database will wipe it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pesaref_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pesaref_test?schema=public"
AUTH_SECRET="test-secret-not-for-production-use-only-in-automated-tests"
APP_URL="http://localhost:3000"
