// PesaRef database schema
// Amounts are stored as whole Kenyan Shillings (Int) - no floating point money.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReferralStatus {
  REGISTERED
  PAYMENT_PENDING
  QUALIFIED
  COMMISSIONED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
  CANCELLED
}

enum WalletTransactionType {
  REFERRAL_COMMISSION
  WITHDRAWAL_REQUEST
  WITHDRAWAL_PAID
  WITHDRAWAL_REJECTED
  ADJUSTMENT
  REVERSAL
}

model User {
  id              String     @id @default(cuid())
  fullName        String
  email           String     @unique
  phone           String     @unique
  passwordHash    String
  role            Role       @default(USER)
  status          UserStatus @default(PENDING_PAYMENT)
  referralCode    String     @unique

  referredById    String?
  referredBy      User?      @relation("Referrer", fields: [referredById], references: [id])
  referredUsers   User[]     @relation("Referrer")

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  emailVerifiedAt  DateTime?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  wallet                 Wallet?
  payments               Payment[]              @relation("PaymentOwner")
  reviewedPayments       Payment[]              @relation("PaymentReviewer")
  withdrawals            Withdrawal[]           @relation("WithdrawalOwner")
  processedWithdrawals   Withdrawal[]           @relation("WithdrawalProcessor")
  referralsAsReferrer    Referral[]             @relation("ReferrerReferrals")
  referralAsReferred     Referral?              @relation("ReferredReferral")
  walletTransactions     WalletTransaction[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  passwordResetTokens    PasswordResetToken[]
  loginAttempts          LoginAttempt[]

  @@index([email])
  @@index([phone])
  @@index([referralCode])
  @@index([referredById])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("PaymentOwner", fields: [userId], references: [id])
  amount           Int
  status           PaymentStatus @default(PENDING)
  paymentReference String
  paymentPhone     String
  paymentDate      DateTime

  reviewedById     String?
  reviewedBy       User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  adminNote        String?
  rejectionReason  String?

  referral         Referral?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentReference])
  @@index([createdAt])
}

model Referral {
  id                  String         @id @default(cuid())
  referrerId          String
  referrer            User           @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  referredId          String         @unique
  referred            User           @relation("ReferredReferral", fields: [referredId], references: [id])
  referralCodeUsed    String
  status              ReferralStatus @default(REGISTERED)

  qualifyingPaymentId String?        @unique
  qualifyingPayment   Payment?       @relation(fields: [qualifyingPaymentId], references: [id])

  commissionAmount    Int?
  walletTransactionId String?        @unique
  walletTransaction   WalletTransaction? @relation("ReferralCommissionTxn", fields: [walletTransactionId], references: [id])

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  walletTransactions  WalletTransaction[] @relation("ReferralLedgerEntries")

  @@index([referrerId])
  @@index([status])
  @@index([createdAt])
}

model Wallet {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  totalEarned       Int      @default(0)
  availableBalance  Int      @default(0)
  pendingWithdrawal Int      @default(0)
  totalWithdrawn    Int      @default(0)
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model WalletTransaction {
  id                  String                @id @default(cuid())
  userId              String
  user                User                  @relation(fields: [userId], references: [id])
  type                WalletTransactionType
  amount              Int
  balanceBefore       Int
  balanceAfter        Int
  reference           String?
  description         String

  relatedReferralId   String?
  relatedReferral     Referral?             @relation("ReferralLedgerEntries", fields: [relatedReferralId], references: [id])

  relatedWithdrawalId String?
  relatedWithdrawal   Withdrawal?           @relation(fields: [relatedWithdrawalId], references: [id])

  referralCommissionFor Referral?           @relation("ReferralCommissionTxn")

  createdAt           DateTime              @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Withdrawal {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation("WithdrawalOwner", fields: [userId], references: [id])
  amount          Int
  phone           String
  note            String?
  status          WithdrawalStatus @default(PENDING)

  mpesaReference  String?
  adminNote       String?
  rejectionReason String?

  processedById   String?
  processedBy     User?            @relation("WithdrawalProcessor", fields: [processedById], references: [id])
  processedAt     DateTime?

  walletTransactions WalletTransaction[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// Used for login-attempt / registration rate limiting since serverless
// functions have no shared in-memory state.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  success    Boolean
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}
